# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tarot_room"

# LLM Configuration (Priority: Hugging Face → OpenAI → Templates)

# Option 1: Hugging Face (Recommended)
HUGGINGFACE_TOKEN="your_huggingface_token_here"
# HF_MODEL_ID="meta-llama/Llama-3.3-70B-Instruct"  # Optional, defaults to this

# Option 2: OpenAI-compatible API (Fallback)
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_BASE_URL="https://api.openai.com/v1"  # Optional
# OPENAI_MODEL="gpt-4o-mini"  # Optional

# Application Configuration
# Set this to your public URL to fix OG image absolute URLs in production
# Priority: NEXT_PUBLIC_APP_URL > APP_URL > VERCEL_URL > RAILWAY_PUBLIC_DOMAIN
# Example for Railway: NEXT_PUBLIC_APP_URL="https://tarot-room-poc-production.up.railway.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"  # Legacy, use NEXT_PUBLIC_APP_URL for OG tags
